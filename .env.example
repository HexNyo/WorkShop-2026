# =============================================================================
# PROJECT RESILIENCE-ALPHA — modèle de configuration
# -----------------------------------------------------------------------------
# Copier en `.env` (ignoré par git) et renseigner chaque valeur.
# `scripts/generate-dev-secrets.sh` (Lot 2) génère automatiquement des valeurs
# aléatoires robustes pour un environnement de développement.
# AUCUNE valeur ci-dessous n'est utilisable telle quelle : les services refusent
# de démarrer si un secret est vide ou fait moins de 16 caractères.
# =============================================================================

# --- MariaDB (instance externe, >= 10.6) -------------------------------------
# Initialisation unique (le mot de passe administrateur n'est jamais stocké ici) :
#   MARIADB_ADMIN_PASSWORD=... docker compose --profile init run --rm db-init
DB_HOST=192.0.2.10
DB_PORT=3306
MARIADB_ADMIN_USER=root
# Hôte autorisé pour les comptes applicatifs : l'IP LAN de la machine Docker ('%' = partout).
RA_DB_CLIENT_HOST=%
RA_DB_AUTH_PASSWORD=
RA_DB_PAYMENT_PASSWORD=
RA_DB_PAYMENT_MAINT_PASSWORD=
RA_DB_REMEDIATION_PASSWORD=

# --- auth-service -------------------------------------------------------------
AUTH_ISSUER=https://auth.resilience-alpha.local
# Clé privée RSA 3072 bits, PEM encodé en base64 sur une ligne.
AUTH_JWT_PRIVATE_KEY_PEM_B64=
AUTH_JWT_KEY_ID=ra-2026-10
# Clés publiques précédentes (rotation) : "kid:base64(PEM)" séparés par des virgules.
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=true
# ESP8266 (LED de login) sur le hotspot Windows ; vide = LED désactivée
AUTH_ESP8266_URL=
# Seuil cosinus SFace : monter (ex. 0.45) si faux positifs, baisser si refus à tort
AUTH_FACE_MATCH_THRESHOLD=0.363
AUTH_LOG_LEVEL=INFO
# Proxys autorisés à transmettre X-Forwarded-For (la passerelle, réseau app).
AUTH_FORWARDED_ALLOW_IPS=172.30.10.0/24
# Amorçage des principaux pré-créés (inactifs tant que leur secret est absent).
AUTH_BOOTSTRAP_ADMIN_SECRET=
AUTH_BOOTSTRAP_ALICE_SECRET=
AUTH_BOOTSTRAP_BOB_SECRET=
AUTH_BOOTSTRAP_MERCHANT_SECRET=
AUTH_BOOTSTRAP_NOC_OPERATOR_SECRET=
AUTH_BOOTSTRAP_SVC_REMEDIATION_SECRET=
AUTH_BOOTSTRAP_SVC_SYNTHETIC_SECRET=
AUTH_BOOTSTRAP_SVC_DETECTOR_SECRET=
AUTH_BOOTSTRAP_SVC_PAYMENT_API_SECRET=

# --- payment-api --------------------------------------------------------------
PAYMENT_LOG_LEVEL=INFO
PAYMENT_DB_POOL_MAX_SIZE=10
PAYMENT_STALE_AFTER_SECONDS=300
# Clé HMAC des tickets d'abonnement SSE (>= 32 caractères).
PAYMENT_STREAM_TICKET_SECRET=

# --- remediation-engine -------------------------------------------------------
REMEDIATION_LOG_LEVEL=INFO
# Secret partagé avec le moteur de détection (signature HMAC du webhook).
REMEDIATION_WEBHOOK_HMAC_SECRET=
# Clé HMAC des tickets SSE de la console de supervision (>= 32 caractères).
REMEDIATION_STREAM_TICKET_SECRET=
REMEDIATION_MIN_CONFIDENCE=0.60
# Garde anti-boucle : au-delà, l'incident est escaladé à un humain.
# (Relever, ex. 30, sur un poste de développement qui rejoue souvent les tests.)
REMEDIATION_MAX_PER_TARGET_PER_HOUR=5
REMEDIATION_RESTORED_HOLD_SECONDS=300
REMEDIATION_HEALTH_POLL_SECONDS=5
# Transaction synthétique planifiée (0 = désactivée) et détection de secours intégrée.
REMEDIATION_SCHEDULED_STM_SECONDS=60
REMEDIATION_WATCHDOG_ENABLED=true

# --- Docker -------------------------------------------------------------------
# Linux : GID du groupe docker (getent group docker | cut -d: -f3). Docker Desktop : 0.
DOCKER_GID=0
# GPU NVIDIA pour ollama : décommenter (séparateur « ; » sous Windows, « : » sous Linux).
#COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# --- frontend-dashboard / passerelle -----------------------------------------
FRONTEND_PUBLIC_PORT=8088
FRONTEND_HTTPS_PORT=8443
# Noms et IP couverts par le certificat autosigné (ajoutez l'IP LAN de la machine Docker).
TLS_SAN=DNS:localhost,DNS:workshop.localhost,IP:127.0.0.1,IP:192.0.2.10
ASSISTANT_UPSTREAM_URL=http://rag-agent:8000

# --- Laboratoire d'injection de pannes (JAMAIS en production) -----------------
CHAOS_LAB_ENABLED=false
